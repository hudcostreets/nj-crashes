outs:
- md5: 5727a2b0d74edfe7e82e8e11b0b689c1.dir
  size: 1356784
  hash: md5
  path: crash_dupes
meta:
  # 2023 duplicate-crash merge analysis. `njdot/crashes.py` reads
  # `crash_dupes/merged.pqt` during the crashes build, but the dir was excluded in
  # `.git/info/exclude` (repo-local, uncommitted — so invisible to `git status` and
  # to anyone inspecting the repo) and tracked nowhere. Reproc round 4 died on it.
  # Unlike the census/SRI caches this is *derived* from a tracked input and the
  # script is deterministic (no network, no prompts), so it's a real stage rather
  # than a tracked snapshot — the audit now verifies it instead of trusting an
  # Oct-2025 artifact that existed only on one laptop.
  # Whole dir as one out: the script also writes merges.pqt, merges-all.pqt and
  # unmerged/*.pqt, which as separate outs would be a co-output group.
  computation:
    cmd: cd ../../.. && njdot/merge_2023_dupes.py
    deps:
      /njdot/data/2023/NewJersey2023Accidents.pqt: 76bdf96e41890d74477a79d4c32147eb
