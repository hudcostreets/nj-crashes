#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["click"]
# ///
"""`wrangler secret put` the njsp-snapshot Worker's secrets from env vars.

Values go to wrangler on stdin; they're never echoed or passed in argv. Run
under `infra/hccs-run` (HCCS CF creds), from a shell where direnv has loaded
the repo `.envrc`:

    infra/hccs-run njsp-snapshot/scripts/put-secrets
"""
import os
import sys
from functools import partial
from os.path import dirname, join
from subprocess import run

from click import command, option

err = partial(print, file=sys.stderr)

# Worker secret name → env var holding its value.
SECRETS = {
    'GH_TOKEN': 'NJSP_SNAPSHOT_GH_TOKEN',
    'SLACK_BOT_TOKEN': 'SLACK_BOT_TOKEN',
}
WORKER_DIR = dirname(dirname(os.path.abspath(__file__)))


@command
@option('-n', '--dry-run', is_flag=True, help='Only check the env vars are set; put nothing.')
@option('-s', '--secret', 'names', multiple=True, help=f'Secret(s) to put (default: all of {", ".join(SECRETS)}).')
def main(dry_run: bool, names: tuple[str, ...]):
    names = names or tuple(SECRETS)
    unknown = [n for n in names if n not in SECRETS]
    if unknown:
        raise SystemExit(f'Unknown secret(s): {", ".join(unknown)}')
    missing = [SECRETS[n] for n in names if not os.environ.get(SECRETS[n])]
    if missing:
        raise SystemExit(f'Unset env var(s): {", ".join(missing)}')
    for name in names:
        if dry_run:
            err(f'Would put {name} (from ${SECRETS[name]})')
            continue
        err(f'Putting {name} (from ${SECRETS[name]})')
        run(
            ['pnpm', 'exec', 'wrangler', 'secret', 'put', name],
            input=os.environ[SECRETS[name]],
            text=True,
            cwd=WORKER_DIR,
            check=True,
        )


if __name__ == '__main__':
    main()
