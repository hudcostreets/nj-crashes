#!/usr/bin/env python3
"""Set the values of the HCCS batch stack's Secrets Manager secrets.

Pulumi (`Pulumi.hccs.yaml` `secrets`) creates the secrets empty, so values never
enter Pulumi state; this fills them in without printing anything secret:
  - `nj-crashes/github-rw-token`  ← an existing secret (default: the RAC one)
  - `nj-crashes/r2-{access-key-id,secret-access-key}` ← `R2_HCCS_RW_*` in ../../.envrc
Idempotent: a secret whose current value already matches is left alone.
"""
import os
import re
import sys

import boto3
from click import command, option

HERE = os.path.dirname(os.path.abspath(__file__))
ENVRC = os.path.join(HERE, os.pardir, os.pardir, '.envrc')
err = lambda *a: print(*a, file=sys.stderr)


def load_envrc(path: str) -> dict[str, str]:
    vars = {}
    pat = re.compile(r'^\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)\s*=\s*(.*)$')
    with open(path) as f:
        for line in f:
            m = pat.match(line)
            if m:
                k, v = m.group(1), m.group(2).strip()
                if v and v[0] in "\"'" and v[-1:] == v[0]:
                    v = v[1:-1]
                vars[k] = v
    return vars


@command()
@option('-g', '--gh-token-source', default='r:nj-crashes/fargate-github-rw-token', help='`<aws profile>:<secret name>` to copy the GH RW token from')
@option('-p', '--profile', default='h', help='AWS profile of the target (HCCS) account')
def main(gh_token_source: str, profile: str):
    src_profile, src_name = gh_token_source.split(':', 1)
    envrc = load_envrc(ENVRC)
    values = {
        'nj-crashes/github-rw-token': boto3.Session(profile_name=src_profile, region_name='us-east-1')
            .client('secretsmanager').get_secret_value(SecretId=src_name)['SecretString'],
        'nj-crashes/r2-access-key-id': envrc['R2_HCCS_RW_ACCESS_KEY_ID'],
        'nj-crashes/r2-secret-access-key': envrc['R2_HCCS_RW_SECRET_ACCESS_KEY'],
    }
    sm = boto3.Session(profile_name=profile, region_name='us-east-1').client('secretsmanager')
    for name, value in values.items():
        if not value:
            raise ValueError(f'{name}: empty source value')
        try:
            current = sm.get_secret_value(SecretId=name)['SecretString']
        except sm.exceptions.ResourceNotFoundException:
            sm.describe_secret(SecretId=name)  # raises if the secret itself is missing
            current = None  # exists (Pulumi-created), no value yet
        if current == value:
            err(f'{name}: up to date')
            continue
        sm.put_secret_value(SecretId=name, SecretString=value)
        err(f'{name}: set')


if __name__ == '__main__':
    main()
