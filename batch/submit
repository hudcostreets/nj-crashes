#!/usr/bin/env python3
"""Submit a job to the Pulumi-owned `nj-crashes` Fargate infra.

Uses `dvx.batch.submit(prefix=<job def>, queue='nj-crashes')` against the queue
+ job definitions that `batch/infra/` (Pulumi) owns — **no `bootstrap` call**,
so nothing is provisioned or mutated here, and **no baked AWS creds**: the
container runs as the `nj-crashes-batch-task` role and gets S3 credentials from
the ECS metadata endpoint. Image + arch live in the job defs (committed Pulumi
config), so this carries only the container command + per-job env overrides.

Job definitions (declared in `batch/infra/Pulumi.dev.yaml` `jobdefs`; `-d` picks):
  # audit — x86 audit image, no secret:
  batch/submit audit

  # reproc — arm64 image built by Pulumi from the committed `ref`, with the GH
  # push-back token; e.g. rebuild one target (plus its stale upstream stages):
  batch/submit -d nj-crashes-reproc -j nj-crashes-cells \
    -b reproc-results/$(date -u +%Y%m%d-%H%M%S) \
    run --no-commit --push each data/cells/cells-s2.db.dvc

The GH-token secret rides in the Pulumi job def (injected by Batch → the
execution role reads it → `FARGATE_GITHUB_RW_TOKEN` in the container), so it's
never handled here; `-b/--results-branch` sets the push-back branch
(`entrypoint.sh` commits+pushes the regenerated `.dvc`s there).
"""
import sys

from click import argument, command, option

from dvx.batch import submit

PREFIX = 'nj-crashes'
SCRATCH_S3 = 's3://nj-crashes/.audit-scratch'


@command(context_settings=dict(ignore_unknown_options=True))
@option('-b', '--results-branch', help='RESULTS_BRANCH for reproc push-back (entrypoint commits+pushes here)')
@option('-d', '--job-def', default=PREFIX, help='Job definition (a `jobdefs` key in `batch/infra/Pulumi.dev.yaml`)')
@option('-j', '--job-name', default='nj-crashes-job', help='Batch job name')
@option('-s', '--njc-s3', default=SCRATCH_S3, help='NJC_S3 for `--s3` stage side-effects (kept off prod)')
@option('-O', '--no-watch', is_flag=True, help="Don't tail the log; just print the job id")
@argument('cmd', nargs=-1, required=True)
def main(results_branch: str, job_def: str, job_name: str, njc_s3: str, no_watch: bool, cmd: tuple[str, ...]):
    """Submit CMD (the container command, e.g. `audit` or `run …`) to the `nj-crashes` queue."""
    env = {'NJC_S3': njc_s3}   # no AWS_* — task role provides creds
    if results_branch:
        env['RESULTS_BRANCH'] = results_branch
    code = submit(
        prefix=job_def,
        queue=PREFIX,
        command=list(cmd),
        job_name=job_name,
        environment=env,
        watch=not no_watch,
    )
    sys.exit(code)


if __name__ == '__main__':
    main()
