outs:
- md5: 53223caccabdbfb4726316942e2b1dc3
  size: 522269
  hash: md5
  path: crash-log.parquet
meta:
  computation:
    cmd: njsp crash_log compute -a njsp/data/crash-log.parquet -i -v
    deps:
      crashes.parquet: 0faa41fe22e5b8bb9997c1707e68c701
    # This stage consumes the FAUQStats XMLs' *history*, not their content at HEAD:
    # it walks every commit that ever touched them. `git_log_deps` records the tip
    # commit touching the pathspec, so the stage is stale iff a new commit did — and
    # dvx exports it as `$DVX_GIT_LOG_SINCE` for the resume cursor. That retires the
    # self-referential input (its own output was its only record of where it left
    # off), which is what made it unbuildable on a fresh checkout in reproc round 5.
    git_log_deps:
      /data/FAUQStats*.xml: 44a7355bc5833425e7138bdc481a4044bf98c9ef
